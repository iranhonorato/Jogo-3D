# Normaliza finais de linha (LF no repositório). O Git detecta binários sozinho
# pelo conteúdo, o que protege arquivos como LightingData.asset (binário mesmo
# com serialização em texto).
* text=auto

# Código e texto
*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.cginc     text
*.py        text diff=python
*.md        text
*.json      text
*.asmdef    text

# Binários explícitos (nunca converter nem tentar diff)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.psd       binary
*.tga       binary
*.tif       binary
*.tiff      binary
*.exr       binary
*.hdr       binary
*.fbx       binary
*.obj       binary
*.blend     binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.aif       binary
*.mp4       binary
*.mov       binary
*.ttf       binary
*.otf       binary
*.dll       binary
